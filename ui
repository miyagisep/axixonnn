                    Fill.BackgroundColor3 = C.Accent; Fill.BorderSizePixel = 0
                    Fill.ZIndex = 15; mkCorner(Fill,2)

                    local Thumb = Instance.new("Frame", Fill)
                    Thumb.Size = UDim2.new(0,10,0,10); Thumb.AnchorPoint = Vector2.new(1,0.5)
                    Thumb.Position = UDim2.new(1,0,0.5,0); Thumb.BackgroundColor3 = C.Accent
