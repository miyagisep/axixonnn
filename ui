                function Section:AddDropdown(cfg)
                    cfg = cfg or {}
                    local options = cfg.Values or {}
                    local selected = cfg.Default or options[1]
                    local callback = cfg.Callback or function() end
                    local opened = false

                    local Wrap = Instance.new("Frame")
                    Wrap.Size = UDim2.new(1,0,0,cfg.Name and 44 or 28)
                    Wrap.BackgroundTransparency = 1; Wrap.ZIndex = 13

                    if cfg.Name then
                        local L = Instance.new("TextLabel", Wrap)
                        L.Size = UDim2.new(1,0,0,16); L.BackgroundTransparency = 1
                        L.Text = cfg.Name; L.TextColor3 = C.Sub; L.TextSize = 11
                        L.Font = Enum.Font.Gotham; L.TextXAlignment = Enum.TextXAlignment.Left; L.ZIndex = 14
                    end
                    local yOff = cfg.Name and 18 or 0

                    local Sel = Instance.new("TextButton", Wrap)
                    Sel.Size = UDim2.new(1,0,0,26); Sel.Position = UDim2.new(0,0,0,yOff)
                    Sel.BackgroundColor3 = Color3.fromRGB(18,18,18)
                    Sel.Text = selected or "Select"; Sel.TextColor3 = C.Text
                    Sel.TextSize = 11; Sel.Font = Enum.Font.Gotham
                    Sel.TextXAlignment = Enum.TextXAlignment.Left
                    Sel.AutoButtonColor = false; Sel.ZIndex = 14
                    mkCorner(Sel,4); mkStroke(Sel,C.BorderBt,1,0); mkPad(Sel,0,0,8,24)

                    local Arrow = Instance.new("ImageLabel", Sel)
                    Arrow.Size = UDim2.new(0,12,0,12); Arrow.AnchorPoint = Vector2.new(1,0.5)
                    Arrow.Position = UDim2.new(1,-6,0.5,0); Arrow.BackgroundTransparency = 1
                    Arrow.Image = "http://www.roblox.com/asset/?id=6282522798"; Arrow.ImageColor3 = C.Muted; Arrow.ZIndex = 15

                    local Dropdown = {Value=selected}
                    local DFrame = Instance.new("Frame", ScreenGui)
                    DFrame.BackgroundColor3 = Color3.fromRGB(18,18,18)
                    DFrame.BorderSizePixel = 0; DFrame.Visible = false; DFrame.ZIndex = 200
                    DFrame.ClipsDescendants = true
                    mkCorner(DFrame,5); mkStroke(DFrame,C.BorderBt,1,0)
                    local DL = Instance.new("UIListLayout", DFrame)
                    DL.Padding = UDim.new(0,2); DL.SortOrder = Enum.SortOrder.LayoutOrder
                    mkPad(DFrame,4,4,4,4)

                    local _hover = false
                    DFrame.MouseEnter:Connect(function() _hover=true end)
                    DFrame.MouseLeave:Connect(function() _hover=false end)

                    local optBtns = {}
                    for _, opt in ipairs(options) do
                        local OBtn = Instance.new("TextButton", DFrame)
                        OBtn.Size = UDim2.new(1,0,0,22)
                        OBtn.BackgroundColor3 = C.Bg5; OBtn.BackgroundTransparency = opt==selected and 0.5 or 1
                        OBtn.Text = opt; OBtn.TextColor3 = opt==selected and C.Accent or C.Sub
                        OBtn.TextSize = 11; OBtn.Font = Enum.Font.Gotham
                        OBtn.AutoButtonColor = false; OBtn.ZIndex = 201
                        mkCorner(OBtn,3); mkPad(OBtn,0,0,8,8)
                        optBtns[opt] = OBtn
                        OBtn.MouseEnter:Connect(function()
                            _hover=true
                            if opt~=Dropdown.Value then Tween(OBtn,{BackgroundTransparency=0.6,TextColor3=C.Text},0.08):Play() end
                        end)
                        OBtn.MouseLeave:Connect(function()
                            if opt~=Dropdown.Value then Tween(OBtn,{BackgroundTransparency=1,TextColor3=C.Sub},0.08):Play() end
                        end)
                        OBtn.MouseButton1Click:Connect(function()
                            local prev=Dropdown.Value; Dropdown.Value=opt; Sel.Text=opt
                            for o,b in pairs(optBtns) do
                                b.TextColor3=o==opt and C.Accent or C.Sub
                                b.BackgroundTransparency=o==opt and 0.5 or 1
                            end
                            opened=false; DFrame.Visible=false; _hover=false
                            Tween(Arrow,{Rotation=0},0.15):Play()
                            if prev~=opt then callback(opt) end
                        end)
                    end

                    local function openDropdown()
                        opened=true
                        local abs=Sel.AbsolutePosition; local fH=#options*24+8
                        local vpH=ScreenGui.AbsoluteSize.Y
                        local posY=abs.Y+26+3
                        if abs.Y+26+fH+4>vpH then posY=abs.Y-fH-4 end
                        DFrame.Size=UDim2.new(0,Sel.AbsoluteSize.X,0,0)
                        DFrame.Position=UDim2.fromOffset(abs.X,posY)
                        DFrame.Visible=true
