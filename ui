    DisplayBg.Position = UDim2.new(0, 8, 0, 32)
    DisplayBg.BackgroundColor3 = C.Bg3
    DisplayBg.BorderSizePixel = 0
    DisplayBg.ZIndex = 151
    DisplayBg.ClipsDescendants = true
