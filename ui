function KraviX:CreateWindow(config)
    config         = config or {}
    config.Name    = config.Name    or "Script"
    config.Version = config.Version or "v1.0"
    config.Mode    = config.Mode    or "Standard"
    config.Url     = config.Url     or ""

    if config.Accent then
        C.Accent  = config.Accent
        C.Accent2 = lighten(config.Accent, 0.09)
        C.BgHover = Color3.new(
            math.clamp(config.Accent.R*0.12,0,1),
            math.clamp(config.Accent.G*0.08,0,1),
            math.clamp(config.Accent.B*0.12,0,1))
    end

    local useLoader = config.Loader ~= false
    TWEEN_SPD = config.TweenSpeed or 1.0
    _notifAccent = C.Accent

    local activeTabIndex = 0
    local Window = {Tabs={}, Keybind=Enum.KeyCode.Unknown}

    Window.Notify        = CreateNotification
    Window.NotifySuccess = function(t,m,d) CreateNotification(t,m,d,"success") end
    Window.NotifyError   = function(t,m,d) CreateNotification(t,m,d,"error")   end
    Window.NotifyInfo    = function(t,m,d) CreateNotification(t,m,d,"info")    end

