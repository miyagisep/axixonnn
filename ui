    function Window:CreateTab(name, iconUrl)
        local Tab = {}
        local tabIndex = #Window.Tabs + 1
        local letter = (name and #name > 0) and name:sub(1,1):upper() or "T"

        -- Slot no IconBar (TextButton)
        local slotY = 50 + (tabIndex - 1) * 44
        local SlotFrame = Instance.new("TextButton", IconBar)
        SlotFrame.Name = "TabSlot_" .. tostring(tabIndex)
        SlotFrame.Size = UDim2.new(0, isSidebarExpanded and (ICON_BAR_EXP_W - 10) or 38, 0, 34)
        SlotFrame.Position = UDim2.new(0, 5, 0, slotY)
        SlotFrame.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
        SlotFrame.BackgroundTransparency = 0
        SlotFrame.Text = ""
        SlotFrame.AutoButtonColor = false
        SlotFrame.ZIndex = 31
        SlotFrame.ClipsDescendants = true
        mkCorner(SlotFrame, 6)
        local SlotStroke = mkStroke(SlotFrame, Color3.fromRGB(32, 32, 38), 1, 0)

        -- Badge da Letra (Lado esquerdo do botão - SEMPRE VISÍVEL & BRANCA!)
        local LetterBadge = Instance.new("Frame", SlotFrame)
        LetterBadge.Size = UDim2.new(0, 34, 0, 34)
        LetterBadge.Position = UDim2.new(0, 0, 0, 0)
