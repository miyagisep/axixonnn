                IndBar.Size = UDim2.new(0, 3, 1, 0)
                IndBar.Position = UDim2.new(0, 0, 0, 0)
                IndBar.BackgroundColor3 = (isSel or isWL or isView) and Color3.fromRGB(124, 58, 237) or Color3.fromRGB(42, 38, 54)
                IndBar.BorderSizePixel = 0
                IndBar.ZIndex = MiniPlayers.Frame.ZIndex + 3
                IndBar:SetAttribute("RelZIndex", 3)

                -- Name Label
