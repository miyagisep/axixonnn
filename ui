        -- Abre o Console F9 do Roblox
        pcall(function()
            game:GetService("StarterGui"):SetCore("DevConsoleVisible", true)
        end)
        task.wait(0.3)

        -- Emissão dos 5 logs de status solicitados (Efeito Typewriter no DevConsole F9)
        local statusLogs = {
            "loaded",
            "config",
            "clound on",
            "bypass working",
            "axion on"
        }

        local function typewriterPrint(text)
            local line = "[Axion] " .. text .. "\n"
            for i = 1, #line do
                local char = line:sub(i, i)
                if rconsoleprint then
                    pcall(function() rconsoleprint(char) end)
                end
                task.wait(0.03)
            end
            print("[Axion] " .. text)
        end

        for _, log in ipairs(statusLogs) do
            typewriterPrint(log)
            task.wait(0.15)
        end

        task.wait(0.6)

        -- Fecha o Console F9 do Roblox
        pcall(function()
            game:GetService("StarterGui"):SetCore("DevConsoleVisible", false)
        end)

        task.wait(0.3)
        onDone()
    end)
end

