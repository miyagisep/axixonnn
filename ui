-- ══════════════════════════════════════════
function KraviX.CreateRadar(Self, Params)
    if typeof(Self) == "table" and not Params and (Self.Name or Self.Size or Self.Parent or Self.Range) then
        Params = Self
    end
    Params = Params or {}
    local Name = Params.Name or Params.name or "Radar ESP"
    local Size = Params.Size or UDim2.new(0, 230, 0, 270)
    local Pos  = Params.Position or UDim2.new(0, 50, 0, 150)
    local ParentGui = Params.Parent or KraviX._LastScreenGui

    if not ParentGui then
        ParentGui = Instance.new("ScreenGui")
        ParentGui.Name = "KraviX_RadarGui"
        ParentGui.ZIndexBehavior = Enum.ZIndexBehavior.Global
        ParentGui.ResetOnSpawn = false
        protect(ParentGui)
        KraviX._LastScreenGui = ParentGui
    end

    local Radar = {
        Entries = {},
        Range = Params.Range or 250,
        Visible = true,
        SweepAngle = 0,
        AutoSweep = Params.AutoSweep ~= false,
    }

    -- Frame Principal (Outer Container)
    local Frame = Instance.new("Frame", ParentGui)
    Frame.Name = "KraviX_Radar"
    Frame.Size = Size
    Frame.Position = Pos
    Frame.BackgroundColor3 = C.Bg2
    Frame.BorderSizePixel = 0
    Frame.ZIndex = 150
    mkCorner(Frame, 8)
    mkStroke(Frame, C.Border, 1, 0)
    MakeDraggable(Frame)
    Radar.Instance = Frame

    -- Glow/Sombra
    local Shadow = Instance.new("ImageLabel", Frame)
    Shadow.Size = UDim2.new(1, 40, 1, 40); Shadow.Position = UDim2.new(0, -20, 0, -20)
    Shadow.BackgroundTransparency = 1; Shadow.Image = "rbxassetid://6015897843"
    Shadow.ImageColor3 = C.Black; Shadow.ImageTransparency = 0.5; Shadow.ZIndex = 149
    Shadow.ScaleType = Enum.ScaleType.Slice; Shadow.SliceCenter = Rect.new(49, 49, 450, 450)

    -- Accent Top Line
    local TopAcc = Instance.new("Frame", Frame)
    TopAcc.Size = UDim2.new(1, 0, 0, 2)
    TopAcc.BackgroundColor3 = C.Accent
    TopAcc.BorderSizePixel = 0
    TopAcc.ZIndex = 152
    mkCorner(TopAcc, 2)

    -- Top Header Bar
    local Header = Instance.new("Frame", Frame)
    Header.Size = UDim2.new(1, 0, 0, 28)
    Header.Position = UDim2.new(0, 0, 0, 2)
    Header.BackgroundTransparency = 1
    Header.ZIndex = 152

    local TitleLbl = Instance.new("TextLabel", Header)
    TitleLbl.Size = UDim2.new(1, -50, 1, 0)
    TitleLbl.Position = UDim2.new(0, 10, 0, 0)
