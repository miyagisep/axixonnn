    FooterLbl.TextXAlignment = Enum.TextXAlignment.Center
    FooterLbl.ZIndex = 153

    -- Auto-sweep animation loop
    RunService.RenderStepped:Connect(function(dt)
        if Radar.Visible and Radar.AutoSweep and Frame.Visible then
            Radar.SweepAngle = (Radar.SweepAngle + dt * 120) % 360
            SweepFrame.Rotation = Radar.SweepAngle
        end
    end)

    -- Methods
    function Radar:SetVisibility(bool)
        Radar.Visible = bool
        Frame.Visible = bool
    end

    function Radar:SetRange(val)
        Radar.Range = math.max(1, val or 250)
        FooterLbl.Text = string.format("%d contatos | %d studs", #Radar:GetEntries(), math.floor(Radar.Range))
    end

    function Radar:SetTitle(text)
        TitleLbl.Text = text
    end

    function Radar:SetFooter(text)
        FooterLbl.Text = text
    end

    function Radar:GetEntries()
        local list = {}
        for _, v in pairs(Radar.Entries) do table.insert(list, v) end
        return list
    end

    function Radar:Upsert(key, data)
        data = data or {}
        local entry = Radar.Entries[key]
        if not entry then
            local blip = Instance.new("Frame", RadarCanvas)
            blip.Size = UDim2.new(0, data.Size or 6, 0, data.Size or 6)
            blip.AnchorPoint = Vector2.new(0.5, 0.5)
            blip.BackgroundColor3 = data.Color or C.Accent
            blip.BorderSizePixel = 0
            blip.ZIndex = 158
            mkCorner(blip, (data.Shape == "Square" and 1) or 3)
            mkStroke(blip, C.Black, 1, 0.4)

            local label = Instance.new("TextLabel", blip)
            label.Size = UDim2.new(0, 60, 0, 12)
            label.Position = UDim2.new(0.5, -30, 1, 2)
            label.BackgroundTransparency = 1
            label.Text = data.Label or ""
            label.TextColor3 = C.Text
            label.TextSize = 9
            label.Font = Enum.Font.Gotham
            label.TextXAlignment = Enum.TextXAlignment.Center
            label.Visible = (data.Label ~= nil and data.Label ~= "")

            entry = { Instance = blip, LabelInstance = label, Color = data.Color or C.Accent }
            Radar.Entries[key] = entry
        end

        if data.Color then
            entry.Instance.BackgroundColor3 = data.Color
            entry.Color = data.Color
        end

        if data.Label then
            entry.LabelInstance.Text = data.Label
            entry.LabelInstance.Visible = (data.Label ~= "")
        end

        -- Calculate relative offset
        local pos = data.Position
        if typeof(pos) == "Vector3" then
            local localChar = LocalPlayer and LocalPlayer.Character
            local root = localChar and localChar:FindFirstChild("HumanoidRootPart")
            if root then
                local rel = root.CFrame:PointToObjectSpace(pos)
                local maxR = RadarCanvas.AbsoluteSize.X / 2 - 8
                local nx = (rel.X / Radar.Range) * maxR
                local ny = (rel.Z / Radar.Range) * maxR
                local dist = math.sqrt(nx*nx + ny*ny)
                if dist > maxR then
                    nx = (nx / dist) * maxR
                    ny = (ny / dist) * maxR
                end
                entry.Instance.Position = UDim2.new(0.5, nx, 0.5, ny)
            end
        elseif typeof(pos) == "Vector2" or typeof(pos) == "UDim2" then
            entry.Instance.Position = (typeof(pos) == "UDim2" and pos) or UDim2.new(0.5, pos.X, 0.5, pos.Y)
        end

        FooterLbl.Text = string.format("%d contatos | %d studs", #Radar:GetEntries(), math.floor(Radar.Range))
    end

    function Radar:Remove(key)
        local entry = Radar.Entries[key]
        if entry then
            if entry.Instance then entry.Instance:Destroy() end
            Radar.Entries[key] = nil
            FooterLbl.Text = string.format("%d contatos | %d studs", #Radar:GetEntries(), math.floor(Radar.Range))
        end
    end

    function Radar:Clear()
        for key, entry in pairs(Radar.Entries) do
            if entry.Instance then entry.Instance:Destroy() end
        end
        Radar.Entries = {}
        FooterLbl.Text = string.format("0 contatos | %d studs", math.floor(Radar.Range))
    end

    return Radar
end

