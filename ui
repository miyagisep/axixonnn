        HealthBarBg.Visible = Preview.Config.Health ~= false
        HealthBarFill.Size = UDim2.new(1, 0, (Preview.Config.HealthPercent or 100) / 100, 0)
        HealthTxt.Text = tostring(Preview.Config.HealthPercent or 100) .. "%"

        DistTag.Visible = Preview.Config.Distance ~= false
        if Preview.Config.DistanceText then DistTag.Text = Preview.Config.DistanceText end

        WeaponTag.Visible = Preview.Config.Weapon ~= false
        if Preview.Config.WeaponText then WeaponTag.Text = Preview.Config.WeaponText end

        if Preview.Config.Chams then
            applyChams(Preview.Config.ChamsColor or C.Accent2)
        else
            removeChams()
        end
    end

    return Preview
end


