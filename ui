                    local function makeInputBox(xOffset, placeholder, defaultTxt)
                        local inner = Instance.new("Frame", PF)
                        inner.Size = UDim2.new(0,110,0,22); inner.Position = UDim2.new(0,xOffset,0,230)
                        inner.BackgroundColor3 = Color3.fromRGB(25,25,25)
                        inner.BorderSizePixel = 0; inner.ZIndex = 302
                        mkCorner(inner,4)

                        local box = Instance.new("TextBox", inner)
                        box.Size = UDim2.new(1,-8,1,0); box.Position = UDim2.new(0,8,0,0)
                        box.BackgroundTransparency = 1
                        box.PlaceholderText = placeholder; box.PlaceholderColor3 = C.Muted
                        box.Text = defaultTxt; box.TextColor3 = C.White
                        box.TextSize = 11; box.Font = Enum.Font.Code
                        box.TextXAlignment = Enum.TextXAlignment.Left
                        box.ZIndex = 303; box.ClearTextOnFocus = false

                        local fs = mkStroke(inner, C.BorderBt, 1, 0)
                        box.Focused:Connect(function()   Tween(fs,{Color=C.Sub},0.12):Play()   end)
                        box.FocusLost:Connect(function() Tween(fs,{Color=C.BorderBt},0.12):Play() end)

                        return box
                    end

                    local HexBox = makeInputBox(6,   "Hex color", "#FFFFFF")
                    local RgbBox = makeInputBox(118, "R, G, B",   "255, 255, 255")

                    local Picker = {Value=color}
                    local flagKey = registerOption(cfg, Picker)

                    local pickerOpen = false
                    local ph, ps, pv = color:ToHSV()
                    local cDrag, hDrag = false, false

                    local function UpdateAll()
                        local c = Color3.fromHSV(ph, ps, pv)
                        Picker.Value = c
                        SwIn.BackgroundColor3      = c
                        TopAcc.BackgroundColor3    = c
                        SatVibImg.BackgroundColor3 = Color3.fromHSV(ph,1,1)
                        CurOut.Position = UDim2.new(ps, 0, 1-pv, 0)
                        HueCur.Position = UDim2.new(0, 0, ph, 0)
                        HexBox.Text     = "#"..c:ToHex():upper()
                        RgbBox.Text     = math.floor(c.R*255)..","
                                       ..math.floor(c.G*255)..","
                                       ..math.floor(c.B*255)
                        callback(c)
                        if flagKey then Window.Flags[flagKey] = c end
                    end

                    HexBox.FocusLost:Connect(function(enter)
                        if enter then
                            local ok, result = pcall(Color3.fromHex, HexBox.Text)
                            if ok and typeof(result)=="Color3" then ph,ps,pv = result:ToHSV() end
                        end
                        UpdateAll()
                    end)
                    RgbBox.FocusLost:Connect(function(enter)
                        if enter then
                            local r,g,b = RgbBox.Text:match("(%d+),?%s*(%d+),?%s*(%d+)")
                            if r then
                                ph,ps,pv = Color3.fromRGB(tonumber(r),tonumber(g),tonumber(b)):ToHSV()
                            end
                        end
                        UpdateAll()
                    end)

                    CanvasHit.InputBegan:Connect(function(i)
                        if i.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
                        cDrag = true
                        local ap = SatVibImg.AbsolutePosition; local as = SatVibImg.AbsoluteSize
                        ps = math.clamp((Mouse.X-ap.X)/as.X, 0, 1)
                        pv = 1-math.clamp((Mouse.Y-ap.Y)/as.Y, 0, 1)
                        UpdateAll()
                    end)

                    HBarHit.InputBegan:Connect(function(i)
                        if i.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
                        hDrag = true
                        local ap = HueIn.AbsolutePosition; local as = HueIn.AbsoluteSize
                        ph = math.clamp((Mouse.Y-ap.Y)/as.Y, 0, 1)
                        UpdateAll()
                    end)

                    UserInputService.InputEnded:Connect(function(i)
                        if i.UserInputType == Enum.UserInputType.MouseButton1 then
                            cDrag = false; hDrag = false
                        end
                    end)
                    UserInputService.InputChanged:Connect(function(i)
                        if i.UserInputType ~= Enum.UserInputType.MouseMovement then return end
                        if cDrag then
                            local ap = SatVibImg.AbsolutePosition; local as = SatVibImg.AbsoluteSize
                            ps = math.clamp((Mouse.X-ap.X)/as.X, 0, 1)
                            pv = 1-math.clamp((Mouse.Y-ap.Y)/as.Y, 0, 1)
                            UpdateAll()
                        end
                        if hDrag then
                            local ap = HueIn.AbsolutePosition; local as = HueIn.AbsoluteSize
                            ph = math.clamp((Mouse.Y-ap.Y)/as.Y, 0, 1)
                            UpdateAll()
                        end
                    end)

                    local _justOpenedPicker = false
                    SwBtn.MouseButton1Click:Connect(function()
                        pickerOpen = not pickerOpen
                        if pickerOpen then
                            _justOpenedPicker = true
                            for _, obj in ipairs(ScreenGui:GetDescendants()) do
                                if obj.Name == "KxColorPicker" and obj ~= PF then
                                    obj.Visible = false
                                end
                            end
                            local abs  = SwOut.AbsolutePosition
                            local sgSz = ScreenGui.AbsoluteSize
                            local px   = abs.X - 234 + SwOut.AbsoluteSize.X
                            local py   = abs.Y + SwOut.AbsoluteSize.Y + 4
                            if py + 262 > sgSz.Y then py = abs.Y - 262 end
                            if px < 2 then px = 2 end
                            if px + 234 > sgSz.X then px = sgSz.X - 236 end
                            PF.Position = UDim2.fromOffset(px, py)
                        end
                        PF.Visible = pickerOpen
                    end)

                    UserInputService.InputBegan:Connect(function(inp)
                        if inp.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
                        if _justOpenedPicker then
                            _justOpenedPicker = false
                            return
                        end
                        if not pickerOpen or cDrag or hDrag then return end
                        local mp = UserInputService:GetMouseLocation()
                        local fp = PF.AbsolutePosition; local fs = PF.AbsoluteSize
                        if not (mp.X>=fp.X and mp.X<=fp.X+fs.X
                             and mp.Y>=fp.Y and mp.Y<=fp.Y+fs.Y) then
                            pickerOpen = false; PF.Visible = false
                        end
                    end)

                    Main:GetPropertyChangedSignal("Visible"):Connect(function()
                        pickerOpen = false; PF.Visible = false
                    end)

                    task.defer(function() callback(color) end)

                    function Picker:Set(c)
                        Picker.Value = c; ph,ps,pv = c:ToHSV(); UpdateAll()
                        if flagKey then Window.Flags[flagKey] = c end
                    end

                    AddItem(Row); return Picker
                end

