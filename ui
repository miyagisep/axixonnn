        if cfg.DistColor ~= nil and DistLbl then DistLbl.TextColor3 = cfg.DistColor end
        if cfg.DistanceColor ~= nil and DistLbl then DistLbl.TextColor3 = cfg.DistanceColor end

        if cfg.Weapon ~= nil or cfg.WeaponESP ~= nil or cfg.WeaponColor ~= nil or cfg.WeaponText ~= nil then
            if cfg.Weapon ~= nil then WeaponLbl.Visible = cfg.Weapon end
            if cfg.WeaponESP ~= nil then WeaponLbl.Visible = cfg.WeaponESP end
            if cfg.WeaponColor ~= nil then WeaponLbl.TextColor3 = cfg.WeaponColor end
            if cfg.WeaponText ~= nil then WeaponLbl.Text = cfg.WeaponText end
        end

        if cfg.HeadDot ~= nil or cfg.HeadDotColor ~= nil then
            if cfg.HeadDot ~= nil then HeadDotActive = (cfg.HeadDot == true) end
            if cfg.HeadDotColor ~= nil then HeadDotColor = cfg.HeadDotColor end
            if not HeadDotActive then HeadDotDotOut.Visible = false end
        end

        if cfg.Highlight ~= nil or cfg.HLFillColor ~= nil or cfg.HLOutlineColor ~= nil or cfg.HLFillTrans ~= nil or cfg.HLOutTrans ~= nil then
            local hl = GetPreviewHighlight()
            local sb = GetPreviewSelectionBox()
            if cfg.Highlight ~= nil then
                local on = (cfg.Highlight == true)
                if hl then hl.Enabled = on end
                if sb then sb.Visible = on end
            end
            if cfg.HLFillColor ~= nil then
                if hl then hl.FillColor = cfg.HLFillColor end
                if sb then sb.SurfaceColor3 = cfg.HLFillColor end
            end
            if cfg.HLOutlineColor ~= nil then
                if hl then hl.OutlineColor = cfg.HLOutlineColor end
                if sb then sb.Color3 = cfg.HLOutlineColor end
            end
            if cfg.HLFillTrans ~= nil then
                if hl then hl.FillTransparency = cfg.HLFillTrans end
                if sb then sb.SurfaceTransparency = cfg.HLFillTrans end
            end
            if cfg.HLOutTrans ~= nil then
                if hl then hl.OutlineTransparency = cfg.HLOutTrans end
                if sb then sb.Transparency = cfg.HLOutTrans end
            end
        end

        if cfg.Tracers ~= nil and TracerLine then TracerLine.Visible = cfg.Tracers end
        if cfg.TracerColor ~= nil and TracerLine then TracerLine.BackgroundColor3 = cfg.TracerColor end

        if cfg.Skeleton ~= nil or cfg.Skeletons ~= nil or cfg.SkeletonESP ~= nil or cfg.SkeletonColor ~= nil then
            if cfg.Skeleton ~= nil then SkeletonActive = (cfg.Skeleton == true) end
            if cfg.Skeletons ~= nil then SkeletonActive = (cfg.Skeletons == true) end
            if cfg.SkeletonESP ~= nil then SkeletonActive = (cfg.SkeletonESP == true) end
            if cfg.SkeletonColor ~= nil then SkeletonColor = cfg.SkeletonColor end
        end

        if cfg.Chams ~= nil or cfg.ChamsColor ~= nil or cfg.ChamsTrans ~= nil then
            if cfg.Chams ~= nil then ChamsActive = (cfg.Chams == true) end
            if cfg.ChamsColor ~= nil then ChamColor = cfg.ChamsColor end
            if cfg.ChamsTrans ~= nil then ChamTrans = cfg.ChamsTrans end

            for _, child in ipairs(ViewmodelFolder:GetDescendants()) do
                if child:IsA("Clothing") or child:IsA("ShirtGraphic") then
                    pcall(function() child.Enabled = not ChamsActive end)
                end
            end

            for original, clone in pairs(RenderObjects) do
                if clone and clone.Parent then
                    if ChamsActive then
                        if clone:IsA("BasePart") then
                            clone.Color = ChamColor
                            clone.Material = Enum.Material.Neon
                            clone.Transparency = ChamTrans or 0.3
                            if clone:IsA("MeshPart") then clone.TextureID = "" end
                        end
                    else
                        if original:IsA("BasePart") then
                            clone.Color = OriginalColors[original] or original.Color
                            clone.Material = OriginalMaterials[original] or original.Material
                            clone.Transparency = OriginalTransparencies[original] or original.Transparency
                            if clone:IsA("MeshPart") and original:IsA("MeshPart") then
                                clone.TextureID = OriginalTextures[original] or original.TextureID
                            end
                        end
                    end
                end
            end
        end
    end

