    function Window:BindESPPreview(espTable)
        if type(espTable) ~= "table" then return end
        Window._BoundESPSettings = espTable
        applyESPPreviewUpdate(espTable)

        task.spawn(function()
            local lastState = {}
            while Window and Window._BoundESPSettings == espTable do
                local changed = false
                local patch = {}
                for k, v in pairs(espTable) do
                    if lastState[k] ~= v then
                        lastState[k] = v
                        patch[k] = v
                        changed = true
                    end
                end
                if changed then
                    applyESPPreviewUpdate(patch)
                end
                task.wait(0.15)
            end
        end)
    end

