    local function ProjectViewportPoint(worldPos)
        local camCF = ViewportCamera.CFrame
        local localPos = camCF:PointToObjectSpace(worldPos)
        if localPos.Z >= 0 then
            return Vector2.new(0, 0), false
        end
        local fov = ViewportCamera.FieldOfView or 70
        local viewSize = VFrame.AbsoluteSize
        if viewSize.X <= 0 or viewSize.Y <= 0 then
            viewSize = Vector2.new(320, 300)
        end
        local aspect = viewSize.X / viewSize.Y
        local h = math.tan(math.rad(fov / 2)) * math.abs(localPos.Z)
        local w = h * aspect
        
        local xNorm = (localPos.X / w + 1) / 2
        local yNorm = (-localPos.Y / h + 1) / 2
        
        local pixelX = xNorm * viewSize.X
        local pixelY = yNorm * viewSize.Y
        
        local inBounds = (xNorm >= -0.2 and xNorm <= 1.2 and yNorm >= -0.2 and yNorm <= 1.2)
        return Vector2.new(pixelX, pixelY), inBounds
    end

