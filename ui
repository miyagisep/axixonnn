            local rad = math.rad(rotAngle)
            local dist = 7.5
            ViewportCam.CFrame = CFrame.new(math.sin(rad) * dist, 0.2, math.cos(rad) * dist) * CFrame.Angles(0, rad, 0)
        end
    end)

    -- Methods
    function Preview:SetVisibility(bool)
        Preview.Visible = bool
        Frame.Visible = bool
    end

    function Preview:SetText(text)
        TitleLbl.Text = text
    end

    function Preview:UpdateConfig(cfg)
        for k, v in pairs(cfg) do Preview.Config[k] = v end

        BoxFrame.Visible = Preview.Config.Box ~= false
        if BoxStroke then BoxStroke.Color = Preview.Config.BoxColor or C.Accent end

