    local function refreshPlayerList()
        for _, child in ipairs(PlayerScroll:GetChildren()) do
            if child:IsA("Frame") then child:Destroy() end
        end

        local allPlayers = Players:GetPlayers()
        local filter = SearchBox.Text:lower()
        local count = 0

        for _, plr in ipairs(allPlayers) do
            local name = (plr.DisplayName or plr.Name):lower()
            local uname = plr.Name:lower()
            if filter == "" or name:find(filter, 1, true) or uname:find(filter, 1, true) then
                count = count + 1
                local isSel = (selectedPlayer == plr)
                local isWL  = isWhitelisted(plr)
                local isView = (_G.KraviX_ViewingPlayer == plr)

                local statusText = "User"
                if plr == LocalPlayer then statusText = "Client" end
                if isWL then statusText = "Whitelisted" end
                if isView then statusText = "Viewing" end

                local Card = Instance.new("Frame", PlayerScroll)
                Card.Size = UDim2.new(1, 0, 0, 36)
                Card.BackgroundColor3 = isSel and Color3.fromRGB(28, 22, 38) or Color3.fromRGB(18, 16, 24)
