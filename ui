                    CanvasOut.BorderSizePixel = 0; CanvasOut.ZIndex = 301
                    mkCorner(CanvasOut,4)

                    local SatVibImg = Instance.new("ImageLabel", CanvasOut)
                    SatVibImg.Size = UDim2.new(1,0,1,0); SatVibImg.BorderSizePixel = 0
                    SatVibImg.Image = "rbxassetid://4155801252"; SatVibImg.ZIndex = 302
                    mkCorner(SatVibImg,4)

                    local CurOut = Instance.new("ImageLabel", SatVibImg)
                    CurOut.AnchorPoint = Vector2.new(0.5,0.5)
                    CurOut.Size = UDim2.new(0,10,0,10); CurOut.Position = UDim2.new(0,0,0,0)
                    CurOut.BackgroundTransparency = 1; CurOut.Image = "rbxassetid://4155801252"
                    CurOut.ImageColor3 = Color3.fromRGB(255,255,255); CurOut.ZIndex = 303

                    local CanvasHit = Instance.new("TextButton", CanvasOut)
                    CanvasHit.Size = UDim2.new(1,0,1,0); CanvasHit.BackgroundTransparency = 1
                    CanvasHit.Text = ""; CanvasHit.ZIndex = 304

                    local HueBar = Instance.new("Frame", PF)
                    HueBar.Size = UDim2.new(0,14,0,200); HueBar.Position = UDim2.new(0,212,0,26)
                    HueBar.BackgroundColor3 = Color3.fromRGB(255,255,255)
