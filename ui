        TimeLbl.TextColor3 = C.Muted
        TimeLbl.TextSize = 10
        TimeLbl.Font = Enum.Font.Code
        TimeLbl.ZIndex = 153

        local TagLbl = Instance.new("TextLabel", Row)
        TagLbl.Size = UDim2.new(0, 42, 0, 16)
        TagLbl.BackgroundTransparency = 1
        TagLbl.Text = tagText
        TagLbl.TextColor3 = tagCol
        TagLbl.TextSize = 10
        TagLbl.Font = Enum.Font.Code
        TagLbl.ZIndex = 153

        local MsgLbl = Instance.new("TextLabel", Row)
        MsgLbl.Size = UDim2.new(1, -106, 0, 0)
        MsgLbl.AutomaticSize = Enum.AutomaticSize.Y
        MsgLbl.BackgroundTransparency = 1
        MsgLbl.Text = tostring(text)
        MsgLbl.TextColor3 = C.Text
        MsgLbl.TextSize = 11
        MsgLbl.Font = Enum.Font.Code
        MsgLbl.TextXAlignment = Enum.TextXAlignment.Left
        MsgLbl.TextWrapped = true
        MsgLbl.ZIndex = 153

        table.insert(Console.Logs, { Text = text, Tag = tag, Time = timeStr })
        BadgeLbl.Text = string.format("%d logs", #Console.Logs)

        task.defer(function()
            ScrollBox.CanvasPosition = Vector2.new(0, 99999)
        end)
    end

    function Console:Warn(text)
        Console:Log(text, "warn")
    end

    function Console:Error(text)
        Console:Log(text, "error")
    end

    function Console:Success(text)
        Console:Log(text, "success")
    end

    return Console
end

