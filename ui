        FullNameLbl.Size = UDim2.new(1, -40, 1, 0)
        FullNameLbl.Position = UDim2.new(0, 38, 0, 0)
        FullNameLbl.BackgroundTransparency = 1
        FullNameLbl.Text = name
        FullNameLbl.TextColor3 = C.Text
        FullNameLbl.TextSize = 11
        FullNameLbl.Font = Enum.Font.GothamBold
        FullNameLbl.TextXAlignment = Enum.TextXAlignment.Left
        FullNameLbl.TextTransparency = isSidebarExpanded and 0 or 1
        FullNameLbl.ZIndex = 33

        IconSlots[tabIndex] = SlotFrame
        IconFallbacks[tabIndex] = LetterLbl

        SlotFrame.MouseEnter:Connect(function()
            ExpandSidebar()
            if tabIndex ~= activeTabIndex then
                Tween(SlotFrame, {BackgroundColor3 = Color3.fromRGB(28, 25, 38)}, 0.12):Play()
                Tween(SlotStroke, {Color = C.Accent}, 0.12):Play()
            end
        end)

        SlotFrame.MouseLeave:Connect(function()
            if tabIndex ~= activeTabIndex then
                Tween(SlotFrame, {BackgroundColor3 = Color3.fromRGB(18, 18, 22)}, 0.12):Play()
                Tween(SlotStroke, {Color = Color3.fromRGB(32, 32, 38)}, 0.12):Play()
            end
        end)

        -- Conteúdo da tab
        local TabContent = Instance.new("Frame", ContentFrame)
        TabContent.Size = UDim2.new(1,0,1,0); TabContent.BackgroundTransparency = 1
        TabContent.BorderSizePixel = 0; TabContent.Visible = false; TabContent.ZIndex = 11

        -- SubTab bar dentro do conteúdo
        local SubTabBar = Instance.new("Frame", TabContent)
        SubTabBar.Size = UDim2.new(1,0,0,32)
        SubTabBar.BackgroundColor3 = C.Bg2; SubTabBar.BackgroundTransparency = 0
        SubTabBar.BorderSizePixel = 0; SubTabBar.ZIndex = 12
        local SubList = Instance.new("UIListLayout", SubTabBar)
        SubList.FillDirection = Enum.FillDirection.Horizontal
        SubList.SortOrder = Enum.SortOrder.LayoutOrder
        SubList.VerticalAlignment = Enum.VerticalAlignment.Center
        SubList.Padding = UDim.new(0,0)
        mkPad(SubTabBar,0,0,10,10)

        local SubSep = Instance.new("Frame", TabContent)
        SubSep.Size = UDim2.new(1,0,0,1); SubSep.Position = UDim2.new(0,0,0,32)
        SubSep.BackgroundColor3 = C.Border; SubSep.BorderSizePixel = 0; SubSep.ZIndex = 12

        local SubContent = Instance.new("Frame", TabContent)
        SubContent.Size = UDim2.new(1,0,1,-33); SubContent.Position = UDim2.new(0,0,0,33)
        SubContent.BackgroundTransparency = 1; SubContent.BorderSizePixel = 0
        SubContent.ZIndex = 11; SubContent.ClipsDescendants = true

        table.insert(Window.Tabs,{
            Btn=SlotFrame, FullNameLbl=FullNameLbl, Container=TabContent, Index=tabIndex,
            SubTabs={}, ActiveSub=0, Name=name
        })
        local tabEntry = Window.Tabs[tabIndex]

        local FadeOverlay = Instance.new("Frame", TabContent)
        FadeOverlay.Size = UDim2.new(1,0,1,0); FadeOverlay.BackgroundColor3 = C.Bg2
        FadeOverlay.BackgroundTransparency = 1; FadeOverlay.BorderSizePixel = 0; FadeOverlay.ZIndex = 50

        local function SelectTab()
            activeTabIndex = tabIndex
            TabNameLbl.Text = name
            task.defer(function()
                local topW = TopBar.AbsoluteSize.X
                local lblW = TabNameLbl.AbsoluteSize.X
                TabNameLbl.Position = UDim2.fromOffset((topW - lblW)/2, 0)
            end)

            for _, t in ipairs(Window.Tabs) do
                local on = t.Index == activeTabIndex
                if not on then t.Container.Visible = false end
                
                local slotFrame = IconSlots[t.Index]
                local letterLbl = IconFallbacks[t.Index]
                if slotFrame then
                    local st = slotFrame:FindFirstChildOfClass("UIStroke")
                    if on then
                        Tween(slotFrame, {BackgroundColor3 = Color3.fromRGB(35, 22, 55)}, 0.12):Play()
                        if st then Tween(st, {Color = C.Accent}, 0.12):Play() end
                    else
                        Tween(slotFrame, {BackgroundColor3 = Color3.fromRGB(18, 18, 22)}, 0.12):Play()
                        if st then Tween(st, {Color = Color3.fromRGB(32, 32, 38)}, 0.12):Play() end
                    end
                end
                if letterLbl then
                    letterLbl.TextColor3 = on and C.Accent or C.Sub
                    letterLbl.Font = on and Enum.Font.GothamBlack or Enum.Font.GothamBold
                end
            end

            -- Move indicador ativo
            local indicatorY = 50 + (tabIndex - 1) * 44 + 3
            Tween(ActiveIndicator,{Position=UDim2.new(0,0,0,indicatorY)},0.2,Enum.EasingStyle.Quint):Play()

            TabContent.Visible = true
            FadeOverlay.BackgroundTransparency = 0
            Tween(FadeOverlay,{BackgroundTransparency=1},0.14,Enum.EasingStyle.Quad):Play()
        end

        SlotFrame.MouseButton1Click:Connect(SelectTab)

        -- Se primeira tab, seleciona automaticamente
        if #Window.Tabs == 1 then SelectTab() end


