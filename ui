    CloseBtn.Text = "×"
    CloseBtn.TextColor3 = C.Sub
    CloseBtn.TextSize = 14
    CloseBtn.Font = Enum.Font.GothamBold
    CloseBtn.ZIndex = 154
    mkCorner(CloseBtn, 4)

    CloseBtn.MouseButton1Click:Connect(function()
        Radar:SetVisibility(false)
    end)
    CloseBtn.MouseEnter:Connect(function() Tween(CloseBtn, {BackgroundColor3 = C.Red, TextColor3 = C.White}, 0.1):Play() end)
    CloseBtn.MouseLeave:Connect(function() Tween(CloseBtn, {BackgroundColor3 = C.Bg4, TextColor3 = C.Sub}, 0.1):Play() end)

    -- Radar Display Container
