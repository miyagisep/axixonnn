    RadarCanvas.Size = UDim2.new(1, 0, 1, 0)
    RadarCanvas.BackgroundTransparency = 1
    RadarCanvas.ClipsDescendants = true
    RadarCanvas.ZIndex = 152

    -- Circular Grid Lines (Concentric rings)
