                            posY = abs.Y+26+3
                        end
                        DFrame.Size = UDim2.new(0,Sel.AbsoluteSize.X,0,0)
                        DFrame.Position = UDim2.fromOffset(abs.X, posY)
                        DFrame.Visible = true
                        Tween(DFrame,{Size=UDim2.new(0,Sel.AbsoluteSize.X,0,fH)},0.18,Enum.EasingStyle.Quint):Play()
                        Tween(Arrow,{Rotation=180},0.15):Play()
