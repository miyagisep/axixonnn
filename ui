                    local SliderBtn = Instance.new("TextButton", Track)
                    SliderBtn.Size = UDim2.new(1,0,0,20); SliderBtn.Position = UDim2.new(0,0,0.5,-10)
                    SliderBtn.BackgroundTransparency = 1; SliderBtn.Text = ""; SliderBtn.ZIndex = 17

