        SubList.Padding = UDim.new(0,0)
        mkPad(SubTabBar,0,0,10,10)

        local SubSep = Instance.new("Frame", TabContent)
        SubSep.Size = UDim2.new(1,0,0,1); SubSep.Position = UDim2.new(0,0,0,32)
        SubSep.BackgroundColor3 = C.Border; SubSep.BorderSizePixel = 0; SubSep.ZIndex = 12

        local SubContent = Instance.new("Frame", TabContent)
        SubContent.Size = UDim2.new(1,0,1,-33); SubContent.Position = UDim2.new(0,0,0,33)
        SubContent.BackgroundTransparency = 1; SubContent.BorderSizePixel = 0
        SubContent.ZIndex = 11; SubContent.ClipsDescendants = true

        table.insert(Window.Tabs,{
            Btn=SlotFrame, FullNameLbl=FullNameLbl, Container=TabContent, Index=tabIndex,
            SubTabs={}, ActiveSub=0, Name=name
        })
        local tabEntry = Window.Tabs[tabIndex]

        local FadeOverlay = Instance.new("Frame", TabContent)
        FadeOverlay.Size = UDim2.new(1,0,1,0); FadeOverlay.BackgroundColor3 = C.Bg2
        FadeOverlay.BackgroundTransparency = 1; FadeOverlay.BorderSizePixel = 0; FadeOverlay.ZIndex = 50

        local function SelectTab()
            if activeTabIndex == tabIndex and TabContent.Visible then return end

            local prevTab = Window.Tabs[activeTabIndex]
            activeTabIndex = tabIndex
            TabNameLbl.Text = name
            task.defer(function()
                local topW = TopBar.AbsoluteSize.X
                local lblW = TabNameLbl.AbsoluteSize.X
                TabNameLbl.Position = UDim2.fromOffset((topW - lblW)/2, 0)
            end)

            -- Animação de saída da tab anterior
            if prevTab and prevTab.Container and prevTab.Container ~= TabContent then
                local prevCont = prevTab.Container
                Tween(prevCont, {Position = UDim2.new(0, 0, 0, -10)}, 0.12, Enum.EasingStyle.Quint, Enum.EasingDirection.In):Play()
                task.delay(0.12, function()
                    if prevTab.Index ~= activeTabIndex then
                        prevCont.Visible = false
                        prevCont.Position = UDim2.new(0, 0, 0, 0)
                    end
                end)
            end

            for _, t in ipairs(Window.Tabs) do
                local on = t.Index == activeTabIndex
                if not on and t.Index ~= (prevTab and prevTab.Index or 0) then
                    t.Container.Visible = false
                end

                local slotFrame = IconSlots[t.Index]
                local letterLbl = IconFallbacks[t.Index]
                if slotFrame then
                    local st = slotFrame:FindFirstChildOfClass("UIStroke")
                    if on then
                        Tween(slotFrame, {BackgroundColor3 = Color3.fromRGB(35, 22, 55)}, 0.15):Play()
                        if st then Tween(st, {Color = C.Accent}, 0.15):Play() end
                    else
                        Tween(slotFrame, {BackgroundColor3 = Color3.fromRGB(18, 18, 22)}, 0.15):Play()
                        if st then Tween(st, {Color = Color3.fromRGB(32, 32, 38)}, 0.15):Play() end
                    end
                end
                if letterLbl then
                    letterLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
                    letterLbl.Font = on and Enum.Font.GothamBlack or Enum.Font.GothamBold
                end
            end

            -- Move indicador ativo com animação fluida
            local indicatorY = 48 + (tabIndex - 1) * 42 + 3
            Tween(ActiveIndicator,{Position=UDim2.new(0,0,0,indicatorY)},0.22,Enum.EasingStyle.Quint):Play()

            -- Animação de entrada fluida da nova tab (Slide de baixo para cima + Fade Overlay)
            TabContent.Position = UDim2.new(0, 0, 0, 12)
            TabContent.Visible = true
            Tween(TabContent, {Position = UDim2.new(0, 0, 0, 0)}, 0.22, Enum.EasingStyle.Quint):Play()

            FadeOverlay.BackgroundTransparency = 0
            Tween(FadeOverlay, {BackgroundTransparency = 1}, 0.20, Enum.EasingStyle.Quad):Play()
        end

        SlotFrame.MouseButton1Click:Connect(SelectTab)

        -- Se primeira tab, seleciona automaticamente
        if #Window.Tabs == 1 then SelectTab() end


