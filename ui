        LetterBadge.ZIndex = 32

        local LetterLbl = Instance.new("TextLabel", LetterBadge)
        LetterLbl.Size = UDim2.new(1, 0, 1, 0)
        LetterLbl.BackgroundTransparency = 1
        LetterLbl.Text = letter
        LetterLbl.TextColor3 = Color3.fromRGB(255, 255, 255) -- BRANCO PURA
        LetterLbl.TextSize = 14
        LetterLbl.Font = Enum.Font.GothamBlack
        LetterLbl.TextXAlignment = Enum.TextXAlignment.Center
        LetterLbl.ZIndex = 33

        -- Nome completo da Tab (ex: "ESP")
