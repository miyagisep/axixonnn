                    local _justOpenedDrop = false
                    local function openDropdown()
                        opened = true; _justOpenedDrop = true
                        local abs = Sel.AbsolutePosition
                        local fH  = #options*24+8
                        local vpH = ScreenGui.AbsoluteSize.Y
                        local posY
                        if abs.Y+26+fH+4 > vpH then
                            posY = abs.Y-fH-4
