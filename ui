function KraviX:CreateWindow(config)
    config         = config or {}
    config.Name    = config.Name    or "Script"
    config.Url     = config.Url     or ""
    config.Version = config.Version or "v1.0"
    config.Mode    = config.Mode    or "Standard"

    if config.Accent then
        C.Accent  = config.Accent
        C.Accent2 = lighten(config.Accent, 0.09)
        C.BgHover = Color3.new(
            math.clamp(config.Accent.R*0.12,0,1),
            math.clamp(config.Accent.G*0.08,0,1),
            math.clamp(config.Accent.B*0.12,0,1))
    end
    if config.BgColor then
        C.Bg  = config.BgColor
        C.Bg2 = lighten(config.BgColor, 0.016)
        C.Bg3 = lighten(config.BgColor, 0.04)
        C.Bg4 = lighten(config.BgColor, 0.06)
        C.Bg5 = lighten(config.BgColor, 0.09)
    end
    if config.BorderColor then C.Border  = config.BorderColor; C.BorderBt = lighten(config.BorderColor,0.07) end
    if config.TextColor   then C.Text    = config.TextColor   end
    if config.SubColor    then C.Sub     = config.SubColor    end
    if config.ShadowColor then C.Shadow  = config.ShadowColor end
    if config.NotifColor  then C.NotifBg = config.NotifColor  end

    local useLoader  = config.Loader     ~= false
    local useSound   = config.Sound      ~= false
    local tweenSpd   = config.TweenSpeed or 1.0
    TWEEN_SPD        = tweenSpd
    local backdropFx = config.Effect
    if backdropFx == nil then backdropFx = "snow" end

    _notifAccentOverride = C.Accent

    local HideWindow, ShowWindow, ToggleWindow
    local activeTabIndex = 0
    local Window = {Tabs={}, Keybind=Enum.KeyCode.Unknown}

    local function wrapNotif(a, b, c, d, ntype)
        if typeof(a) == "table" then
            CreateNotification(b, c, tonumber(d) or 3, ntype)
        else
            CreateNotification(a, b, tonumber(c) or 3, ntype)
        end
    end

    Window.Notify        = function(a, b, c, d) wrapNotif(a, b, c, d, nil) end
    Window.NotifySuccess = function(a, b, c, d) wrapNotif(a, b, c, d, "success") end
    Window.NotifyError   = function(a, b, c, d) wrapNotif(a, b, c, d, "error") end
    Window.NotifyInfo    = function(a, b, c, d) wrapNotif(a, b, c, d, "info") end

    Window.Flags   = {}
    Window.Options = {}
    Window.Folder  = config.Folder or "KraviX/configs"

    local function registerOption(cfg, control)
        local rawKey = cfg and (cfg.Flag or cfg.Name)
        if not rawKey then return nil end
        local key = rawKey
        local count = 1
        while Window.Options[key] do
            count = count + 1
            key = rawKey .. "_" .. tostring(count)
        end
        Window.Options[key] = control
        if control.Value ~= nil then
            Window.Flags[key] = control.Value
        end
        return key
    end

    local HttpService = game:GetService("HttpService")

    local function ensureConfigFolder(folderPath)
        if not isfolder or not makefolder then return false end
        pcall(function()
            local parts = string.split(folderPath, "/")
            local current = ""
            for _, part in ipairs(parts) do
                if part ~= "" then
                    current = (current == "") and part or (current .. "/" .. part)
                    if not isfolder(current) then
                        makefolder(current)
                    end
                end
            end
        end)
        return isfolder and isfolder(folderPath)
    end

    function Window:SaveConfig(cfgName)
        if not cfgName or cfgName == "" then cfgName = "default" end
        cfgName = string.gsub(cfgName, "[^%w_%-]", "")
        if cfgName == "" then cfgName = "default" end

        local folder = Window.Folder or "KraviX/configs"
        ensureConfigFolder(folder)

        local data = {}
        for flagKey, control in pairs(Window.Options) do
            if control and control.Value ~= nil then
                local val = control.Value
                if typeof(val) == "Color3" then
                    data[flagKey] = {
                        __type = "Color3",
                        R = math.floor(val.R * 255 + 0.5),
                        G = math.floor(val.G * 255 + 0.5),
                        B = math.floor(val.B * 255 + 0.5)
                    }
                elseif typeof(val) == "EnumItem" then
                    data[flagKey] = {
                        __type = "EnumItem",
                        EnumType = tostring(val.EnumType),
                        Name = val.Name
                    }
                elseif type(val) == "table" and val.type then
                    local vVal = val.value
                    local strVal = typeof(vVal) == "EnumItem" and vVal.Name or tostring(vVal)
                    data[flagKey] = {
                        __type = "MouseKeybind",
                        BindType = val.type,
                        Value = strVal
                    }
                else
                    data[flagKey] = val
                end
            end
        end

        local jsonStr
        local encOk, err = pcall(function() jsonStr = HttpService:JSONEncode(data) end)
        if not encOk or not jsonStr then
            CreateNotification("KraviX Config", "Erro ao serializar config: " .. tostring(err), 3, "error")
            return false
        end

        if writefile then
            local filePath = folder .. "/" .. cfgName .. ".json"
            local writeOk, writeErr = pcall(function() writefile(filePath, jsonStr) end)
            if writeOk then
                CreateNotification("KraviX Config", "Configuração '" .. cfgName .. "' salva com sucesso!", 3, "success")
                return true
            else
                CreateNotification("KraviX Config", "Erro ao salvar arquivo: " .. tostring(writeErr), 3, "error")
            end
        else
            CreateNotification("KraviX Config", "Executor não suporta writefile!", 3, "error")
        end
        return false
    end

    function Window:LoadConfig(cfgName)
        if not cfgName or cfgName == "" then cfgName = "default" end
        cfgName = string.gsub(cfgName, "[^%w_%-]", "")
        local folder = Window.Folder or "KraviX/configs"
        local filePath = folder .. "/" .. cfgName .. ".json"

        if not readfile or not isfile or not isfile(filePath) then
            CreateNotification("KraviX Config", "Configuração '" .. cfgName .. "' não encontrada!", 3, "error")
            return false
        end

        local fileContent
        local readOk, readErr = pcall(function() fileContent = readfile(filePath) end)
        if not readOk or not fileContent then
            CreateNotification("KraviX Config", "Erro ao ler config: " .. tostring(readErr), 3, "error")
            return false
        end

        local decoded
        local decOk, decErr = pcall(function() decoded = HttpService:JSONDecode(fileContent) end)
        if not decOk or type(decoded) ~= "table" then
            CreateNotification("KraviX Config", "Arquivo de config corrompido!", 3, "error")
            return false
        end

        local loadedCount = 0
        for flagKey, savedVal in pairs(decoded) do
            local control = Window.Options[flagKey]
            if control and control.Set then
                pcall(function()
                    if type(savedVal) == "table" and savedVal.__type then
                        if savedVal.__type == "Color3" then
                            control:Set(Color3.fromRGB(savedVal.R or 255, savedVal.G or 255, savedVal.B or 255))
                        elseif savedVal.__type == "EnumItem" then
                            if Enum.KeyCode[savedVal.Name] then
                                control:Set(Enum.KeyCode[savedVal.Name])
                            end
                        elseif savedVal.__type == "MouseKeybind" then
                            local bVal
                            if savedVal.BindType == "mouse" then
                                bVal = Enum.UserInputType[savedVal.Value] or Enum.UserInputType.MouseButton2
                            else
                                bVal = Enum.KeyCode[savedVal.Value] or Enum.KeyCode.E
                            end
                            control:Set({type = savedVal.BindType, value = bVal})
                        end
                    else
                        control:Set(savedVal)
                    end
                    loadedCount = loadedCount + 1
                end)
            end
        end

        CreateNotification("KraviX Config", "Configuração '" .. cfgName .. "' carregada com sucesso! (" .. loadedCount .. " opções)", 3, "success")
        return true
    end

    function Window:DeleteConfig(cfgName)
        if not cfgName or cfgName == "" then return false end
        cfgName = string.gsub(cfgName, "[^%w_%-]", "")
        local folder = Window.Folder or "KraviX/configs"
        local filePath = folder .. "/" .. cfgName .. ".json"

        if isfile and isfile(filePath) and delfile then
            local delOk, err = pcall(function() delfile(filePath) end)
            if delOk then
                CreateNotification("KraviX Config", "Configuração '" .. cfgName .. "' deletada!", 3, "info")
                return true
            else
                CreateNotification("KraviX Config", "Erro ao deletar: " .. tostring(err), 3, "error")
            end
        else
            CreateNotification("KraviX Config", "Arquivo não encontrado para deletar!", 3, "error")
        end
        return false
    end

    function Window:GetConfigs()
        local folder = Window.Folder or "KraviX/configs"
        ensureConfigFolder(folder)
        local list = {}
        if listfiles then
            pcall(function()
                local files = listfiles(folder)
                for _, f in ipairs(files) do
                    if string.sub(f, -5) == ".json" then
                        local fname = string.gsub(f, "\\", "/")
                        fname = string.match(fname, "[^/]+$") or fname
                        fname = string.sub(fname, 1, #fname - 5)
                        if fname ~= "autoload_config" then
                            table.insert(list, fname)
                        end
                    end
                end
            end)
        end
        table.sort(list)
        return list
    end

