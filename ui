    LineV.BackgroundColor3 = C.Muted2
    LineV.BackgroundTransparency = 0.5
    LineV.BorderSizePixel = 0
    LineV.ZIndex = 153

    -- Cardinal Directions (N, S, E, W)
    local function mkCardinal(text, pos, anchor)
        local lbl = Instance.new("TextLabel", RadarCanvas)
        lbl.Size = UDim2.new(0, 14, 0, 14)
        lbl.Position = pos
        lbl.AnchorPoint = anchor
        lbl.BackgroundTransparency = 1
        lbl.Text = text
        lbl.TextColor3 = text == "N" and C.Accent or C.Muted
