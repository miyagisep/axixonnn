-- ══════════════════════════════════════════
-- HELPERS
-- ══════════════════════════════════════════
local function Tween(obj, props, t, style, dir)
    return TweenService:Create(obj,
        TweenInfo.new((t or 0.15)*TWEEN_SPD,
            style or Enum.EasingStyle.Quint,
            dir   or Enum.EasingDirection.Out), props)
end

local function mkCorner(p, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 4); c.Parent = p; return c
end

local function mkStroke(p, col, thick, trans)
    local s = Instance.new("UIStroke")
    s.Color = col or Color3.fromRGB(40,40,40)
    s.Thickness = thick or 1; s.Transparency = trans or 0; s.Parent = p; return s
end

local function mkPad(p, t, b, l, r)
    local pad = Instance.new("UIPadding")
    pad.PaddingTop    = UDim.new(0, t or 0)
    pad.PaddingBottom = UDim.new(0, b or 0)
    pad.PaddingLeft   = UDim.new(0, l or 0)
    pad.PaddingRight  = UDim.new(0, r or 0)
    pad.Parent = p; return pad
end

local function lighten(c, amt)
    return Color3.new(
        math.clamp(c.R+amt,0,1),
        math.clamp(c.G+amt,0,1),
        math.clamp(c.B+amt,0,1))
end

local function protect(gui)
    for _, v in ipairs(CoreGui:GetChildren()) do
        if v.Name == gui.Name then v:Destroy() end
    end
    if gethui then
        for _, v in ipairs(gethui():GetChildren()) do
            if v.Name == gui.Name then v:Destroy() end
        end
    end
    if syn and syn.protect_gui then syn.protect_gui(gui); gui.Parent = CoreGui
    elseif gethui              then gui.Parent = gethui()
    else                            gui.Parent = CoreGui end
end

local function MakeDraggable(frame, handle)
    handle = handle or frame
    local drag, ds, sp
    handle.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or
           i.UserInputType == Enum.UserInputType.Touch then
            drag = true; ds = i.Position; sp = frame.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if drag and (i.UserInputType == Enum.UserInputType.MouseMovement or
                     i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - ds
            frame.Position = UDim2.new(sp.X.Scale, sp.X.Offset+d.X,
                                       sp.Y.Scale, sp.Y.Offset+d.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or
           i.UserInputType == Enum.UserInputType.Touch then drag = false end
    end)
end

-- ══════════════════════════════════════════
-- EFEITO DE NEVE (Snow Particles)
-- ══════════════════════════════════════════
local function StartSnow(parent)
    local cont = Instance.new("Frame", parent)
    cont.Name = "SnowContainer"
    cont.Size = UDim2.new(1, 0, 1, 0)
    cont.BackgroundTransparency = 1
    cont.ClipsDescendants = true
    cont.ZIndex = 1

    local flakes = {}
    for i = 1, 120 do
        local sz = math.random(1, 3)
        local f = Instance.new("Frame", cont)
        f.Size = UDim2.new(0, sz, 0, sz)
        f.BackgroundColor3 = C.White
        f.BackgroundTransparency = math.random(40, 75) / 100
        f.BorderSizePixel = 0
        mkCorner(f, sz)
        flakes[i] = {
            frame = f,
            x = math.random(0, 1000) / 1000,
            y = math.random(-10, 100) / 100,
            speed = math.random(6, 14) / 1000,
            drift = math.random(-4, 4) / 10000
        }
        f.Position = UDim2.new(flakes[i].x, 0, flakes[i].y, 0)
    end

    RunService.Heartbeat:Connect(function(dt)
        if not cont or not cont.Parent then return end
        for _, fl in ipairs(flakes) do
            fl.y = fl.y + fl.speed * dt * 60
            fl.x = fl.x + fl.drift * dt * 60
            if fl.y > 1.05 then
                fl.y = -0.05
                fl.x = math.random(0, 1000) / 1000
            end
            if fl.x < 0 then fl.x = 1 elseif fl.x > 1 then fl.x = 0 end
            fl.frame.Position = UDim2.new(fl.x, 0, fl.y, 0)
        end
    end)
end


