                l.Padding = UDim.new(0,2); l.SortOrder = Enum.SortOrder.LayoutOrder
                l.HorizontalAlignment = Enum.HorizontalAlignment.Left
                mkPad(s,10,14,12,10)
                l:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                    s.CanvasSize = UDim2.new(0,0,0,l.AbsoluteContentSize.Y+18)
                end)
                return s
            end

            local LeftScroll  = makeCol(0,-1)
            local Div = Instance.new("Frame", SubPanel)
            Div.Size = UDim2.new(0,1,1,0); Div.Position = UDim2.new(0.5,0,0,0)
            Div.BackgroundColor3 = C.Border; Div.BorderSizePixel = 0; Div.ZIndex = 12
            local RightScroll = makeCol(0.5,-1)
            RightScroll.Position = UDim2.new(0.5,2,0,0)

            table.insert(tabEntry.SubTabs,{Btn=SBtn,Panel=SubPanel,Index=subIndex})

            local SubFadeOverlay = Instance.new("Frame",SubPanel)
            SubFadeOverlay.Size = UDim2.new(1,0,1,0); SubFadeOverlay.BackgroundColor3 = C.Bg2
            SubFadeOverlay.BackgroundTransparency = 1; SubFadeOverlay.BorderSizePixel = 0; SubFadeOverlay.ZIndex = 50

            local function SelectSub()
                if tabEntry.ActiveSub == subIndex and SubPanel.Visible then return end

                tabEntry.ActiveSub = subIndex
                for _, st in ipairs(tabEntry.SubTabs) do
                    local on = st.Index == subIndex
                    if not on then st.Panel.Visible = false end
                    Tween(st.Btn,{TextColor3=on and C.Accent or C.Muted},0.12):Play()
                    st.Btn.Font = on and Enum.Font.GothamBold or Enum.Font.Gotham
                end

                SubPanel.Position = UDim2.new(0, 0, 0, 10)
                SubPanel.Visible = true
                Tween(SubPanel, {Position = UDim2.new(0, 0, 0, 0)}, 0.20, Enum.EasingStyle.Quint):Play()

                SubFadeOverlay.BackgroundTransparency = 0
                Tween(SubFadeOverlay, {BackgroundTransparency = 1}, 0.18, Enum.EasingStyle.Quad):Play()
            end

            SBtn.MouseButton1Click:Connect(SelectSub)
            SBtn.MouseEnter:Connect(function()
                if subIndex ~= tabEntry.ActiveSub then Tween(SBtn,{TextColor3=C.Sub},0.08):Play() end
            end)
            SBtn.MouseLeave:Connect(function()
                if subIndex ~= tabEntry.ActiveSub then Tween(SBtn,{TextColor3=C.Muted},0.08):Play() end
            end)
            if #tabEntry.SubTabs == 1 then SelectSub() end

            -- ══════════════════════════════════
