                s.BackgroundTransparency = 1; s.BorderSizePixel = 0
                s.ScrollBarThickness = 2; s.ScrollBarImageColor3 = C.Muted2
                s.CanvasSize = UDim2.new(0,0,0,0); s.ZIndex = 12
