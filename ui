end

local function MakeDraggable(frame, handle)
    handle = handle or frame
    local drag, ds, sp
    handle.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            drag = true; ds = i.Position; sp = frame.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if drag and (i.UserInputType == Enum.UserInputType.MouseMovement
                  or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - ds
            frame.Position = UDim2.new(sp.X.Scale, sp.X.Offset+d.X,
                                       sp.Y.Scale, sp.Y.Offset+d.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then drag = false end
    end)
end

local _notifSlots          = {}
local _notifAccentOverride = nil

local function CreateNotification(title, text, duration, ntype)
    if typeof(title) == "table" then
        title, text, duration, ntype = text, duration, ntype, nil
    end
    title = tostring(title or "")
    text  = tostring(text or "")
    PlaySound(SOUND_NOTIF)
    ntype = ntype or "info"
    local dotColor
    if     ntype == "error"   then dotColor = C.Red
    elseif ntype == "success" then dotColor = C.Green
    else   dotColor = _notifAccentOverride or C.Accent end

    local G = Instance.new("ScreenGui")
    G.Name = "KxNotif_"..tostring(tick())
    G.IgnoreGuiInset = true; G.ZIndexBehavior = Enum.ZIndexBehavior.Global
    G.ResetOnSpawn = false
    if syn and syn.protect_gui then syn.protect_gui(G); G.Parent = CoreGui
    elseif gethui               then G.Parent = gethui()
    else                             G.Parent = CoreGui end

    local H = 30; local MARGIN = 10
    local slot = 0
    while _notifSlots[slot] do slot += 1 end
    _notifSlots[slot] = true

    -- Largura máxima da notificação: nunca mais que a tela menos margens
    -- dos dois lados. Isso evita que textos longos empurrem o card pra
    -- fora da borda esquerda da tela (o bug da "bolinha roxa cortada").
    local viewW = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize.X or 800
    local MAXW  = math.min(320, viewW - MARGIN*2)

    local F = Instance.new("Frame", G)
    F.Size             = UDim2.new(0,MAXW,0,H); F.AutomaticSize = Enum.AutomaticSize.Y
    F.Position         = UDim2.new(1,30,1,-(MARGIN+(H+MARGIN)*slot))
    F.AnchorPoint      = Vector2.new(1,1)
    F.BackgroundColor3 = C.NotifBg; F.BackgroundTransparency = 0; F.BorderSizePixel = 0
    F.ClipsDescendants = true
    mkCorner(F, 10); mkStroke(F, Color3.fromRGB(36,36,36), 1, 0)

    local List = Instance.new("UIListLayout", F)
    List.FillDirection      = Enum.FillDirection.Horizontal
    List.VerticalAlignment  = Enum.VerticalAlignment.Top
    List.Padding            = UDim.new(0,7)
    mkPad(F, 7,7,12,14)

    local Dot = Instance.new("Frame", F)
    Dot.Size = UDim2.new(0,7,0,7); Dot.Position = UDim2.new(0,0,0,3)
    Dot.BackgroundColor3 = dotColor
    Dot.BorderSizePixel = 0; mkCorner(Dot,4); Dot.LayoutOrder = 0

    local Sep = Instance.new("Frame", F)
    Sep.Size = UDim2.new(0,1,0,12); Sep.Position = UDim2.new(0,0,0,1)
    Sep.BackgroundColor3 = Color3.fromRGB(40,40,40)
    Sep.BorderSizePixel = 0; Sep.LayoutOrder = 1

    -- Coluna de texto: largura fixa máxima (não AutomaticSize), permitindo
    -- quebra de linha (TextWrapped) em vez de crescer pra fora da tela.
    local TextCol = Instance.new("Frame", F)
    TextCol.Size = UDim2.new(0, MAXW - 40, 0, 0)
    TextCol.AutomaticSize = Enum.AutomaticSize.Y
    TextCol.BackgroundTransparency = 1; TextCol.LayoutOrder = 2

    local TextList = Instance.new("UIListLayout", TextCol)
    TextList.FillDirection = Enum.FillDirection.Vertical
    TextList.Padding       = UDim.new(0,2)

    local T = Instance.new("TextLabel", TextCol)
    T.Size = UDim2.new(1,0,0,0); T.AutomaticSize = Enum.AutomaticSize.Y
    T.BackgroundTransparency = 1; T.Text = title
    T.TextColor3 = C.Text; T.TextSize = 11; T.Font = Enum.Font.GothamBold
    T.TextXAlignment = Enum.TextXAlignment.Left; T.TextWrapped = true; T.LayoutOrder = 0

    local D = Instance.new("TextLabel", TextCol)
    D.Size = UDim2.new(1,0,0,0); D.AutomaticSize = Enum.AutomaticSize.Y
    D.BackgroundTransparency = 1; D.Text = text
    D.TextColor3 = C.Sub; D.TextSize = 10; D.Font = Enum.Font.Gotham
    D.TextXAlignment = Enum.TextXAlignment.Left; D.TextWrapped = true; D.LayoutOrder = 1

    local dur = duration or 3
    Tween(F,{Position=UDim2.new(1,-MARGIN,1,-(MARGIN+(H+MARGIN)*slot))},0.28,Enum.EasingStyle.Back):Play()
    task.delay(dur, function()
        _notifSlots[slot] = nil
        Tween(F,{Position=UDim2.new(1,30,1,-(MARGIN+(H+MARGIN)*slot))},0.2,Enum.EasingStyle.Quint,Enum.EasingDirection.In):Play()
        task.wait(0.22); G:Destroy()
    end)
end

