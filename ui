    ScreenGui.Name = "KraviX"; ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Global
    ScreenGui.ResetOnSpawn = false; ScreenGui.IgnoreGuiInset = true
    protect(ScreenGui)
    Window._ScreenGui = ScreenGui

