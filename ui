                        if enter then local ok,r=pcall(Color3.fromHex,HexBox.Text) if ok and typeof(r)=="Color3" then ph,ps,pv=r:ToHSV() end end
                        UpdateAll()
                    end)
                    RgbBox.FocusLost:Connect(function(enter)
                        if enter then local r,g,b=RgbBox.Text:match("(%d+),?%s*(%d+),?%s*(%d+)") if r then ph,ps,pv=Color3.fromRGB(tonumber(r),tonumber(g),tonumber(b)):ToHSV() end end
                        UpdateAll()
                    end)
                    CanvasHit.InputBegan:Connect(function(i)
                        if i.UserInputType~=Enum.UserInputType.MouseButton1 then return end
                        cDrag=true; local ap=SatVibImg.AbsolutePosition; local as=SatVibImg.AbsoluteSize
                        ps=math.clamp((Mouse.X-ap.X)/as.X,0,1); pv=1-math.clamp((Mouse.Y-ap.Y)/as.Y,0,1); UpdateAll()
                    end)
                    HBarHit.InputBegan:Connect(function(i)
                        if i.UserInputType~=Enum.UserInputType.MouseButton1 then return end
                        hDrag=true; local ap=HueIn.AbsolutePosition; local as=HueIn.AbsoluteSize
                        ph=math.clamp((Mouse.Y-ap.Y)/as.Y,0,1); UpdateAll()
                    end)
                    UserInputService.InputEnded:Connect(function(i)
                        if i.UserInputType==Enum.UserInputType.MouseButton1 then cDrag=false; hDrag=false end
                    end)
                    UserInputService.InputChanged:Connect(function(i)
                        if i.UserInputType~=Enum.UserInputType.MouseMovement then return end
                        if cDrag then
                            local ap=SatVibImg.AbsolutePosition; local as=SatVibImg.AbsoluteSize
                            ps=math.clamp((Mouse.X-ap.X)/as.X,0,1); pv=1-math.clamp((Mouse.Y-ap.Y)/as.Y,0,1); UpdateAll()
                        end
                        if hDrag then
                            local ap=HueIn.AbsolutePosition; local as=HueIn.AbsoluteSize
                            ph=math.clamp((Mouse.Y-ap.Y)/as.Y,0,1); UpdateAll()
                        end
                    end)
                    SwBtn.MouseButton1Click:Connect(function()
                        pickerOpen=not pickerOpen
                        if pickerOpen then
                            for _,obj in ipairs(ScreenGui:GetDescendants()) do
                                if obj.Name=="KxColorPicker" and obj~=PF then obj.Visible=false end
                            end
                            local abs=SwOut.AbsolutePosition; local sgSz=ScreenGui.AbsoluteSize
                            local px=abs.X-234+SwOut.AbsoluteSize.X; local py=abs.Y+SwOut.AbsoluteSize.Y+4
                            if py+262>sgSz.Y then py=abs.Y-262 end
                            if px<2 then px=2 end; if px+234>sgSz.X then px=sgSz.X-236 end
                            PF.Position=UDim2.fromOffset(px,py)
                        end
                        PF.Visible=pickerOpen
                    end)
                    UserInputService.InputBegan:Connect(function(inp)
                        if inp.UserInputType~=Enum.UserInputType.MouseButton1 then return end
                        if not pickerOpen or cDrag or hDrag then return end
                        local mp=UserInputService:GetMouseLocation(); local fp=PF.AbsolutePosition; local fs=PF.AbsoluteSize
                        if not(mp.X>=fp.X and mp.X<=fp.X+fs.X and mp.Y>=fp.Y and mp.Y<=fp.Y+fs.Y) then
                            pickerOpen=false; PF.Visible=false
                        end
                    end)
                    Main:GetPropertyChangedSignal("Visible"):Connect(function() pickerOpen=false; PF.Visible=false end)
                    task.defer(function() callback(color) end)
                    function Picker:Set(c) Picker.Value=c; ph,ps,pv=c:ToHSV(); UpdateAll() end
                    AddItem(Row); return Picker
                end

                return Section
            end

            return SubTab
        end

        function Tab:AddSection(sectionName, column)
            if #tabEntry.SubTabs == 0 then Tab:AddSubTab("_default") end
            local lastSub = tabEntry.SubTabs[#tabEntry.SubTabs]
            return lastSub:AddSection(sectionName, column)
        end



        return Tab
    end

    -- Loader + show
    if useLoader then
        CreateLoader(ScreenGui, function()
            ShowWindow()
            CreateNotification("KraviX","Carregado com sucesso!",3,"success")
        end)
    else
        ShowWindow()
    end

    return Window
end

return KraviX
