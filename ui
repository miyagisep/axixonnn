    local function RemoveObjectFromPreview(obj)
        local clone = RenderObjects[obj]
        if not clone then return end
        RenderObjects[obj] = nil
        OriginalTextures[obj] = nil
        OriginalMaterials[obj] = nil
        OriginalColors[obj] = nil
        OriginalTransparencies[obj] = nil
        if clone.Parent and clone.Parent:IsA("Accoutrement") then
            clone.Parent:Destroy()
        else
            clone:Destroy()
        end
    end

    local function AddObjectToPreview(obj)
        if not obj or not ValidClasses[obj.ClassName] then return end

        local isArch = obj.Archivable
        obj.Archivable = true
        local ok, clone = pcall(function() return obj:Clone() end)
        obj.Archivable = isArch

        if not ok or not clone then return end

        if obj:IsA("BasePart") then
            clone.Anchored = true
            clone.CanCollide = false
            RenderObjects[obj] = clone
            OriginalMaterials[obj] = clone.Material
            OriginalColors[obj] = clone.Color
            OriginalTransparencies[obj] = clone.Transparency
            if clone:IsA("MeshPart") then
                OriginalTextures[obj] = clone.TextureID
            end
            if ChamsActive then
                clone.Color = ChamColor
                clone.Material = Enum.Material.Neon
                clone.Transparency = ChamTrans
                if clone:IsA("MeshPart") then clone.TextureID = "" end
            end
        elseif obj:IsA("Accoutrement") then
            if obj:FindFirstChild("Handle") and clone:FindFirstChild("Handle") then
                clone.Handle.Anchored = true
                clone.Handle.CanCollide = false
                RenderObjects[obj.Handle] = clone.Handle
                OriginalMaterials[obj.Handle] = clone.Handle.Material
                OriginalColors[obj.Handle] = clone.Handle.Color
                OriginalTransparencies[obj.Handle] = clone.Handle.Transparency
                if clone.Handle:IsA("MeshPart") then
                    OriginalTextures[obj.Handle] = clone.Handle.TextureID
                end
                if ChamsActive then
                    clone.Handle.Color = ChamColor
                    clone.Handle.Material = Enum.Material.Neon
                    clone.Handle.Transparency = ChamTrans
                    if clone.Handle:IsA("MeshPart") then clone.Handle.TextureID = "" end
                end
            end
        elseif obj:IsA("Clothing") or obj:IsA("ShirtGraphic") then
            if ChamsActive then
                pcall(function() clone.Enabled = false end)
            end
        elseif obj:IsA("Humanoid") then
            clone.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        end

        return clone
    end

