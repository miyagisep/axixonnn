    Shadow.ImageColor3 = C.Black; Shadow.ImageTransparency = 0.4; Shadow.ZIndex = 9
    Shadow.ScaleType = Enum.ScaleType.Slice; Shadow.SliceCenter = Rect.new(49,49,450,450)

    -- ══════════════════════════════════════
    -- COLUNA DE ÍCONES / TABS (esquerda)
