    -- ══════════════════════════════════════
    -- SHOW / HIDE / TOGGLE
    -- ══════════════════════════════════════
    local function HideWindow()
        if not Main.Visible then return end
        Main.ClipsDescendants = true
        Tween(Main,{Size=UDim2.new(0,WIN_W*0.88,0,WIN_H*0.88),
            Position=UDim2.new(0.5,-(WIN_W*0.88)/2,0.5,-(WIN_H*0.88)/2),
            BackgroundTransparency=1},0.18,Enum.EasingStyle.Quint,Enum.EasingDirection.In):Play()
        Tween(Backdrop,{BackgroundTransparency=1},0.18):Play()
        task.wait(0.2*TWEEN_SPD)
        Main.Visible=false; Backdrop.Visible=false
        Main.Size=UDim2.new(0,WIN_W,0,WIN_H)
        Main.Position=UDim2.new(0.5,-WIN_W/2,0.5,-WIN_H/2)
        Main.BackgroundTransparency=0; Backdrop.BackgroundTransparency=0.55
        Main.ClipsDescendants=false
    end

    local function ShowWindow()
        if Main.Visible then return end
        Main.Visible=true; Backdrop.Visible=true
        Main.Size=UDim2.new(0,WIN_W*0.88,0,WIN_H*0.88)
        Main.Position=UDim2.new(0.5,-(WIN_W*0.88)/2,0.5,-(WIN_H*0.88)/2)
        Main.BackgroundTransparency=1
        Backdrop.BackgroundTransparency=1
        Tween(Backdrop,{BackgroundTransparency=0.55},0.25,Enum.EasingStyle.Quad):Play()
        Tween(Main,{Size=UDim2.new(0,WIN_W,0,WIN_H),
            Position=UDim2.new(0.5,-WIN_W/2,0.5,-WIN_H/2),
            BackgroundTransparency=0},0.42,Enum.EasingStyle.Back,Enum.EasingDirection.Out):Play()
        task.delay(0.2,function()
            Main.ClipsDescendants=false
        end)
    end

    function Window:ToggleWindow()
        if Main.Visible then HideWindow() else ShowWindow() end
    end
    Window.ShowWindow = ShowWindow
    Window.HideWindow = HideWindow

    CloseBtn.MouseButton1Click:Connect(HideWindow)
    MakeDraggable(Main,TopBar)

