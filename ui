    end

    function Console:Log(text, tag)
        tag = tag or "info"
        local timeStr = os.date("%H:%M:%S")
        local tagText = "[INFO]"
        local tagCol  = C.Accent

        if tag == "warn" then
            tagText = "[WARN]"; tagCol = Color3.fromRGB(245, 158, 11)
        elseif tag == "error" then
            tagText = "[ERR]";  tagCol = C.Red
        elseif tag == "success" then
            tagText = "[OK]";   tagCol = C.Green
        elseif tag == "exec" then
            tagText = "[EXEC]"; tagCol = Color3.fromRGB(56, 189, 248)
        elseif typeof(tag) == "Color3" then
            tagText = "[LOG]";  tagCol = tag
        end

        local Row = Instance.new("Frame", ScrollBox)
        Row.Size = UDim2.new(1, 0, 0, 0)
        Row.AutomaticSize = Enum.AutomaticSize.Y
        Row.BackgroundTransparency = 1
        Row.ZIndex = 152

